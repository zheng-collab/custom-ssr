<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless smoke test for the Avalonia UI: instantiates and renders every window without a
       display server, so XAML/resource/binding problems surface on Linux CI or a dev box.
       Run:  dotnet run -c Release [output-dir]   (from this folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SecureGateway.Mac\SecureGateway.Mac.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

</Project>
