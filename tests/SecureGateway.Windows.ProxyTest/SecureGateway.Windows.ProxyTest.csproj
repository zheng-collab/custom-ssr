<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs on the GitHub Windows runner: exercises SystemProxyService against the real registry. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Match the app, which is published self-contained for win-x64. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SecureGateway\SecureGateway.csproj" />
  </ItemGroup>
</Project>
