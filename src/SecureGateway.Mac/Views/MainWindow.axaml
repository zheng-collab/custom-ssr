<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SecureGateway.Mac"
        x:Class="SecureGateway.Mac.Views.MainWindow"
        Title="SecureGateway" Width="760" Height="640"
        MinWidth="560" MinHeight="520" WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <local:EnumBoolConverter x:Key="EnumBool"/>
    <local:BoolToStatusBrushConverter x:Key="StatusBrush"/>
    <local:StringNotEmptyConverter x:Key="NotEmpty"/>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*">

    <!-- Header: brand left, account right. Connection state lives on Home, not here. -->
    <Border Grid.Row="0" Background="{StaticResource Mantle}" Padding="20,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Ellipse Width="10" Height="10"
                   Fill="{Binding IsConnected, Converter={StaticResource StatusBrush}, ConverterParameter=red}"/>
          <TextBlock Text="SecureGateway" FontSize="16" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="{Binding UserEmail}" Classes="label" VerticalAlignment="Center"/>
          <Button Content="Sign out" Classes="quiet" FontSize="12" Padding="8,4" Click="OnSignOut"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Padding="0" Margin="8,0,8,0">

      <!-- HOME: one status, one action, one server choice. -->
      <TabItem Header="Home">
        <ScrollViewer>
          <StackPanel MaxWidth="520" Margin="20,24,20,24" Spacing="16">

            <Border Classes="card" Padding="24">
              <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <Ellipse Width="16" Height="16" VerticalAlignment="Center"
                           Fill="{Binding IsConnected, Converter={StaticResource StatusBrush}, ConverterParameter=red}"/>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding StatusHeadline}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusDetail}" Classes="hint" MaxWidth="400"
                               IsVisible="{Binding StatusDetail, Converter={StaticResource NotEmpty}}"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="Server" Classes="label"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <ComboBox Name="CmbServer" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                              IsEnabled="{Binding IsIdle}" PlaceholderText="No servers yet"
                              AutomationProperties.Name="Server">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="Test" Margin="8,0,0,0" Command="{Binding TestLatencyCommand}"
                            ToolTip.Tip="Measure the latency to this server"/>
                  </Grid>
                  <TextBlock Classes="hint" IsVisible="{Binding !HasServers}"
                             Text="Open the Servers tab and click Sync Shared to load your company's servers."/>
                </StackPanel>

                <Button Name="BtnConnect" Classes="connect"
                        Classes.primary="{Binding !IsConnected}" Classes.disconnect="{Binding IsConnected}"
                        Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}"
                        IsEnabled="{Binding !IsConnecting}"/>

                <!-- Live numbers only while connected; zeros are noise. -->
                <UniformGrid Columns="4" IsVisible="{Binding IsConnected}">
                  <StackPanel>
                    <TextBlock Text="Latency" Classes="label"/>
                    <TextBlock Text="{Binding Latency}" FontSize="15" FontWeight="SemiBold"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Download" Classes="label"/>
                    <TextBlock Text="{Binding DownloadSpeed}" FontSize="15" FontWeight="SemiBold"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Upload" Classes="label"/>
                    <TextBlock Text="{Binding UploadSpeed}" FontSize="15" FontWeight="SemiBold"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Time" Classes="label"/>
                    <TextBlock Text="{Binding ConnectionDuration}" FontSize="15" FontWeight="SemiBold"/>
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Routing" FontSize="14" FontWeight="SemiBold"/>
                <WrapPanel>
                  <RadioButton Content="Rule-Based" GroupName="ProxyMode" Margin="0,0,20,0"
                               IsChecked="{Binding ProxyMode, Converter={StaticResource EnumBool}, ConverterParameter=Rule, Mode=TwoWay}"/>
                  <RadioButton Content="Global Proxy" GroupName="ProxyMode" Margin="0,0,20,0"
                               IsChecked="{Binding ProxyMode, Converter={StaticResource EnumBool}, ConverterParameter=Global, Mode=TwoWay}"/>
                  <RadioButton Content="Direct (No Proxy)" GroupName="ProxyMode"
                               IsChecked="{Binding ProxyMode, Converter={StaticResource EnumBool}, ConverterParameter=Direct, Mode=TwoWay}"/>
                </WrapPanel>
                <TextBlock Text="{Binding ModeDescription}" Classes="hint"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- SERVERS: list first; actions grouped by what they act on. -->
      <TabItem Header="Servers">
        <Grid RowDefinitions="Auto,*,Auto" Margin="12,16,12,12">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <WrapPanel>
              <Button Content="Sync Shared" Classes="primary" Command="{Binding SyncSharedServersCommand}" Margin="0,0,8,6"
                      ToolTip.Tip="Load the servers your company has shared"/>
              <Button Content="Import from Clipboard" Command="{Binding ImportFromClipboardCommand}" Margin="0,0,8,6"
                      ToolTip.Tip="Paste a vmess:// or ss:// link"/>
              <Button Content="Add Server" Command="{Binding AddServerCommand}" Margin="0,0,8,6"/>
            </WrapPanel>
            <Button Grid.Column="1" Content="Test All" Command="{Binding TestAllLatencyCommand}" Margin="0,0,0,6"
                    VerticalAlignment="Top"/>
          </Grid>

          <Panel Grid.Row="1">
            <ListBox Name="ServerList" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                     AutomationProperties.Name="Servers">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="12,10" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                      <Border Classes="badge" Background="{StaticResource Surface1}" IsVisible="{Binding IsShared}">
                        <TextBlock Text="Shared" FontSize="10" FontWeight="SemiBold"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="label">
                      <Run Text="{Binding Protocol}"/><Run Text="  ·  "/><Run Text="{Binding Address}"/><Run Text=":"/><Run Text="{Binding Port}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Remarks}" Classes="hint"
                               IsVisible="{Binding Remarks, Converter={StaticResource NotEmpty}}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding !HasServers}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="360" Spacing="6">
              <TextBlock Text="No servers yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Classes="hint" TextAlignment="Center"
                         Text="Click Sync Shared to load your company's servers, or copy a server link and click Import from Clipboard."/>
            </StackPanel>
          </Panel>

          <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Selected server:" Classes="label" VerticalAlignment="Center" Margin="0,0,10,6"/>
            <Button Content="Edit" Command="{Binding EditServerCommand}" Margin="0,0,8,6"/>
            <Button Content="Duplicate" Command="{Binding DuplicateServerCommand}" Margin="0,0,8,6"/>
            <Button Content="Test" Command="{Binding TestLatencyCommand}" Margin="0,0,8,6"/>
            <Button Content="Share QR" Command="{Binding ShowShareLinkCommand}" Margin="0,0,8,6"
                    ToolTip.Tip="Show a QR code / link for phone VPN apps"/>
            <Button Content="Share" Command="{Binding ShareServerCommand}" Margin="0,0,8,6"
                    ToolTip.Tip="Admins: publish this server to every user"/>
            <Button Content="Unshare" Command="{Binding UnshareServerCommand}" Margin="0,0,8,6"
                    ToolTip.Tip="Admins: stop sharing this server"/>
            <Button Content="Delete" Classes="danger" Command="{Binding DeleteServerCommand}" Margin="0,0,0,6"/>
          </WrapPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer Margin="12,16,12,12">
          <StackPanel MaxWidth="520" HorizontalAlignment="Left" Spacing="10">
            <TextBlock Text="Application Settings" Classes="h2" Margin="0,0,0,6"/>
            <CheckBox Content="Start at login" IsChecked="{Binding AutoStart}"/>
            <CheckBox Content="Auto-connect on startup" IsChecked="{Binding AutoConnect}"/>
            <CheckBox Content="Keep running in the menu bar when the window is closed" IsChecked="{Binding MinimizeToTray}"/>

            <TextBlock Text="Sites that bypass the VPN" Classes="h2" Margin="0,16,0,0"/>
            <TextBlock Classes="hint"
                       Text="One per line. These connect directly with your real IP, in every proxy mode. Use it for sites that reject the VPN's address (banks, streaming, company portals). A domain covers all its subdomains; IPs and CIDR ranges work too. Applied when you click elsewhere; the tunnel restarts for a second."/>
            <TextBox Name="TxtDirectDomains" Text="{Binding DirectDomainsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="120"
                     FontFamily="Menlo, Consolas, monospace" FontSize="12" TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Sites that bypass the VPN"/>

            <TextBlock Text="About" Classes="h2" Margin="0,16,0,0"/>
            <TextBlock Classes="hint">
              <Run Text="SecureGateway v"/><Run Text="{Binding AppVersion, Mode=OneTime}"/><Run Text=" for macOS. Supports V2Ray (VMess) and Shadowsocks via the bundled v2ray-core engine."/>
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Log">
        <Grid RowDefinitions="Auto,*" Margin="12,16,12,12">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Clear Log" Command="{Binding ClearLogCommand}"/>
          </StackPanel>
          <ListBox Name="LogListBox" Grid.Row="1" ItemsSource="{Binding LogEntries}"
                   FontFamily="Menlo, Consolas, monospace" FontSize="12"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
