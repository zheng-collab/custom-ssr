<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows (WPF) app. All non-UI logic lives in SecureGateway.Core, shared with the macOS app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- System.Windows.Forms.NotifyIcon powers the tray icon -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>SecureGateway</AssemblyName>
    <RootNamespace>SecureGateway</RootNamespace>
    <Description>Enterprise VPN/Proxy Client with V2Ray and Shadowsocks support</Description>
    <Company>SecureGateway</Company>
    <Product>SecureGateway VPN Client</Product>
    <!-- Publish as a plain folder (installed by the Inno Setup installer), NOT a single-file
         self-extracting exe. A self-extracting bundle unpacks native DLLs + the v2ray engine to
         %TEMP% at every launch, which antivirus heuristics treat like a dropper and quarantine.
         A normal folder of files next to the engine scans far more cleanly. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureGateway.Core\SecureGateway.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="v2ray-core\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
