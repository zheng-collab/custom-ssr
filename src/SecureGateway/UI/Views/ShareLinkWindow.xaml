<Window x:Class="SecureGateway.UI.Views.ShareLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share Link / QR Code" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E2E">
    <StackPanel Margin="24">
        <TextBlock x:Name="TxtTitle" FontSize="16" FontWeight="Bold" Foreground="#CDD6F4"/>
        <TextBlock Foreground="#A6ADC8" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,14"
                   Text="Scan with your phone's VPN app (Android: v2rayNG or Shadowsocks; iPhone: Shadowrocket) or copy the link. Anyone with this link can use the server — share it only with staff."/>

        <Border Background="White" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
            <Image x:Name="ImgQr" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <TextBox x:Name="TxtLink" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                 Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="8" Margin="0,14,0,0"
                 MaxHeight="90" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnCopy" Content="Copy link" Width="110" Height="34" Margin="0,0,10,0"
                    Background="#89B4FA" Foreground="#1E1E2E" BorderBrush="#89B4FA" FontWeight="Bold" Click="OnCopy"/>
            <Button Content="Close" Width="90" Height="34"
                    Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70" Click="OnClose"/>
        </StackPanel>
    </StackPanel>
</Window>
