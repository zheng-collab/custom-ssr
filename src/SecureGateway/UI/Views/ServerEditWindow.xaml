<Window x:Class="SecureGateway.UI.Views.ServerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SecureGateway.Models"
        Title="Server Configuration" Height="580" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E2E">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General settings -->
                <TextBlock Text="General" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,8"/>

                <TextBlock Text="Server Name"/>
                <TextBox x:Name="TxtName" Text="{Binding Name}"/>

                <TextBlock Text="Address (IP or domain)"/>
                <TextBox x:Name="TxtAddress" Text="{Binding Address}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Port"/>
                        <TextBox x:Name="TxtPort" Text="{Binding Port}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Protocol"/>
                        <ComboBox x:Name="CmbProtocol" SelectedItem="{Binding Protocol}"
                                  SelectionChanged="OnProtocolChanged">
                            <models:ProxyProtocol>V2Ray</models:ProxyProtocol>
                            <models:ProxyProtocol>Shadowsocks</models:ProxyProtocol>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- V2Ray Settings -->
                <StackPanel x:Name="V2RayPanel" Margin="0,12,0,0">
                    <TextBlock Text="V2Ray Settings" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,8"/>

                    <TextBlock Text="User ID (UUID)"/>
                    <TextBox x:Name="TxtUserId" Text="{Binding V2RayUserId}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Alter ID"/>
                            <TextBox Text="{Binding V2RayAlterId}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Security"/>
                            <ComboBox SelectedItem="{Binding V2RaySecurity}">
                                <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">auto</sys:String>
                                <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">aes-128-gcm</sys:String>
                                <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">chacha20-poly1305</sys:String>
                                <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">none</sys:String>
                                <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">zero</sys:String>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Transport"/>
                    <ComboBox x:Name="CmbTransport" SelectedItem="{Binding V2RayTransport}">
                        <models:V2RayTransport>TCP</models:V2RayTransport>
                        <models:V2RayTransport>WebSocket</models:V2RayTransport>
                        <models:V2RayTransport>HTTP2</models:V2RayTransport>
                        <models:V2RayTransport>GRPC</models:V2RayTransport>
                    </ComboBox>

                    <TextBlock Text="Path"/>
                    <TextBox Text="{Binding V2RayPath}"/>

                    <TextBlock Text="Host"/>
                    <TextBox Text="{Binding V2RayHost}"/>

                    <CheckBox Content="Enable TLS" IsChecked="{Binding V2RayTls}" Margin="0,8"/>

                    <TextBlock Text="SNI (Server Name Indication)"/>
                    <TextBox Text="{Binding V2RaySni}"/>
                </StackPanel>

                <!-- Shadowsocks Settings -->
                <StackPanel x:Name="ShadowsocksPanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="Shadowsocks Settings" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,8"/>

                    <TextBlock Text="Password"/>
                    <TextBox Text="{Binding SsPassword}"/>

                    <TextBlock Text="Encryption"/>
                    <ComboBox SelectedItem="{Binding SsEncryption}">
                        <models:ShadowsocksEncryption>Aes128Gcm</models:ShadowsocksEncryption>
                        <models:ShadowsocksEncryption>Aes256Gcm</models:ShadowsocksEncryption>
                        <models:ShadowsocksEncryption>ChaCha20IetfPoly1305</models:ShadowsocksEncryption>
                        <models:ShadowsocksEncryption>XChaCha20IetfPoly1305</models:ShadowsocksEncryption>
                    </ComboBox>

                    <TextBlock Text="Plugin (optional)"/>
                    <TextBox Text="{Binding SsPlugin}"/>

                    <TextBlock Text="Plugin Options"/>
                    <TextBox Text="{Binding SsPluginOptions}"/>
                </StackPanel>

                <!-- Local Ports -->
                <TextBlock Text="Local Ports" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" Margin="0,12,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SOCKS5 Port"/>
                        <TextBox Text="{Binding LocalSocksPort}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="HTTP Port"/>
                        <TextBox Text="{Binding LocalHttpPort}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Remarks"/>
                <TextBox Text="{Binding Remarks}" AcceptsReturn="True" Height="50" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="100" Height="36" Margin="0,0,10,0"
                    Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70"
                    Click="OnCancel"/>
            <Button Content="Save" Width="100" Height="36"
                    Background="#89B4FA" Foreground="#1E1E2E" BorderBrush="#89B4FA" FontWeight="Bold"
                    Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
