<Window x:Class="SecureGateway.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SecureGateway.UI.Converters"
        xmlns:models="clr-namespace:SecureGateway.Models"
        Title="SecureGateway - Enterprise VPN Client" Height="640" Width="920"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" Foreground="#CDD6F4"
        Closing="OnWindowClosing" StateChanged="OnWindowStateChanged">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToColorConverter x:Key="BoolToColor"/>
        <converters:BoolToConnectTextConverter x:Key="BoolToConnectText"/>
        <converters:BoolToStatusColorConverter x:Key="BoolToStatusColor"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:EnumBooleanConverter x:Key="EnumBool"/>

        <!-- Base button style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
        </Style>

        <Style x:Key="ConnectButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="32,14"/>
        </Style>

        <!-- Tab style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#181825" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Margin="0,0,10,0"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusColor}}"/>
                    <TextBlock Text="SecureGateway" FontSize="18" FontWeight="Bold" Foreground="#CDD6F4"/>
                    <TextBlock Text=" VPN" FontSize="18" Foreground="#89B4FA"/>
                </StackPanel>

                <!-- Status text -->
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="#A6ADC8" FontSize="13"/>

                <!-- User info + Connect -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserEmail}" Foreground="#A6ADC8" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Sign Out" Style="{StaticResource ModernButton}"
                            Click="OnLogoutClick" Padding="10,6" FontSize="11"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource ConnectButton}"
                            Command="{Binding ToggleConnectionCommand}"
                            Content="{Binding IsConnected, Converter={StaticResource BoolToConnectText}}"
                            Background="{Binding IsConnected, Converter={StaticResource BoolToColor}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Margin="0">
            <TabControl.Resources>
                <Style TargetType="TabControl">
                    <Setter Property="Background" Value="#1E1E2E"/>
                </Style>
            </TabControl.Resources>

            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Connection Stats Cards -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                        <!-- Upload -->
                        <Border Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Upload" Foreground="#A6ADC8" FontSize="12"/>
                                <TextBlock Text="{Binding UploadSpeed}" FontSize="20" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Download -->
                        <Border Background="#313244" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Download" Foreground="#A6ADC8" FontSize="12"/>
                                <TextBlock Text="{Binding DownloadSpeed}" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Latency -->
                        <Border Background="#313244" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Latency" Foreground="#A6ADC8" FontSize="12"/>
                                <TextBlock Text="{Binding Latency}" FontSize="20" FontWeight="Bold" Foreground="#F9E2AF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Duration -->
                        <Border Background="#313244" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Duration" Foreground="#A6ADC8" FontSize="12"/>
                                <TextBlock Text="{Binding ConnectionDuration}" FontSize="20" FontWeight="Bold" Foreground="#CBA6F7" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Active Server Info -->
                    <Border Grid.Row="1" Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Active Server" Foreground="#A6ADC8" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedServer.Name, FallbackValue='No server selected'}"
                                           FontSize="16" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <TextBlock Text="{Binding ConnectionInfo}" Foreground="#A6ADC8" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Test" Style="{StaticResource ModernButton}"
                                        Command="{Binding TestLatencyCommand}" Margin="0,0,8,0"/>
                                <Button Content="Reconnect" Style="{StaticResource AccentButton}"
                                        Command="{Binding ConnectCommand}"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Proxy Mode -->
                    <Border Grid.Row="2" Background="#313244" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Proxy Mode" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <UniformGrid Columns="3">
                                <RadioButton Content="  Global Proxy" GroupName="ProxyMode" Foreground="#CDD6F4" FontSize="13"
                                             IsChecked="{Binding ProxyMode, Converter={StaticResource EnumBool}, ConverterParameter=Global}"
                                             Margin="0,0,8,0"/>
                                <RadioButton Content="  Rule-Based" GroupName="ProxyMode" Foreground="#CDD6F4" FontSize="13"
                                             IsChecked="{Binding ProxyMode, Converter={StaticResource EnumBool}, ConverterParameter=Rule}"
                                             Margin="4,0,4,0"/>
                                <RadioButton Content="  Direct (No Proxy)" GroupName="ProxyMode" Foreground="#CDD6F4" FontSize="13"
                                             IsChecked="{Binding ProxyMode, Converter={StaticResource EnumBool}, ConverterParameter=Direct}"
                                             Margin="8,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Servers Tab -->
            <TabItem Header="Servers">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Server toolbar -->
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="+ Add Server" Style="{StaticResource AccentButton}"
                                Command="{Binding AddServerCommand}" Margin="0,0,8,4"/>
                        <Button Content="Edit" Style="{StaticResource ModernButton}"
                                Command="{Binding EditServerCommand}" Margin="0,0,8,4"/>
                        <Button Content="Duplicate" Style="{StaticResource ModernButton}"
                                Command="{Binding DuplicateServerCommand}" Margin="0,0,8,4"/>
                        <Button Content="Delete" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteServerCommand}" Margin="0,0,8,4"/>
                        <Button Content="Import from Clipboard" Style="{StaticResource ModernButton}"
                                Command="{Binding ImportFromClipboardCommand}" Margin="0,0,8,4"/>
                        <Button Content="Test All" Style="{StaticResource ModernButton}"
                                Command="{Binding TestAllLatencyCommand}" Margin="0,0,8,4"/>
                        <!-- Shared server controls -->
                        <Border Background="#45475A" CornerRadius="4" Padding="1,0" Margin="4,0,8,4"
                                VerticalAlignment="Center" Width="1" Height="24"/>
                        <Button Style="{StaticResource AccentButton}" Margin="0,0,8,4"
                                Command="{Binding SyncSharedServersCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sync Shared" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Share" Style="{StaticResource ModernButton}"
                                Command="{Binding ShareServerCommand}" Margin="0,0,8,4"/>
                        <Button Content="Unshare" Style="{StaticResource DangerButton}"
                                Command="{Binding UnshareServerCommand}" Margin="0,0,0,4"/>
                    </WrapPanel>

                    <!-- Server list -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Servers}"
                             SelectedItem="{Binding SelectedServer}"
                             Background="#181825" BorderBrush="#313244"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#313244" CornerRadius="6" Padding="14" Margin="2,2,2,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                                                <Border Background="#89B4FA" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="SHARED" FontSize="9" FontWeight="Bold" Foreground="#1E1E2E"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Foreground="#A6ADC8" FontSize="12">
                                                    <Run Text="{Binding Protocol}"/>
                                                    <Run Text=" | "/>
                                                    <Run Text="{Binding Address}"/>
                                                    <Run Text=":"/>
                                                    <Run Text="{Binding Port}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Remarks}" Foreground="#6C7086" FontSize="11"
                                                       Visibility="{Binding Remarks, Converter={StaticResource BoolToVis}}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Right">
                                                <Run Text="SOCKS:"/>
                                                <Run Text="{Binding LocalSocksPort}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Right">
                                                <Run Text="HTTP:"/>
                                                <Run Text="{Binding LocalHttpPort}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2A2A4A"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#232338"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                        <TextBlock Text="Application Settings" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,16"/>

                        <CheckBox Content="Start with Windows" IsChecked="{Binding AutoStart}"
                                  Foreground="#CDD6F4" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox Content="Auto-connect on startup" IsChecked="{Binding AutoConnect}"
                                  Foreground="#CDD6F4" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox Content="Minimize to system tray on close" IsChecked="{Binding MinimizeToTray}"
                                  Foreground="#CDD6F4" FontSize="13" Margin="0,0,0,20"/>

                        <TextBlock Text="About" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" Margin="0,12,0,8"/>
                        <TextBlock Foreground="#A6ADC8" FontSize="13" TextWrapping="Wrap">
                            SecureGateway v1.0.0 - Enterprise VPN Client
                            <LineBreak/>
                            Supports V2Ray (VMess) and Shadowsocks protocols.
                            <LineBreak/>
                            Requires v2ray-core to be placed in the v2ray-core subdirectory.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Log Tab -->
            <TabItem Header="Log">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Clear Log" Style="{StaticResource ModernButton}"
                                Command="{Binding ClearLogCommand}"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                             Background="#181825" Foreground="#CDD6F4"
                             BorderBrush="#313244" FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             x:Name="LogListBox"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#181825" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusColor}}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#A6ADC8" FontSize="11"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Foreground="#6C7086" FontSize="11">
                    <Run Text="{Binding UserEmail, Mode=OneWay}"/>
                    <Run Text=" | SecureGateway v1.0.0"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
