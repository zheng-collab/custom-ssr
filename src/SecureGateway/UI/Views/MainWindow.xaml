<Window x:Class="SecureGateway.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SecureGateway.UI"
        xmlns:converters="clr-namespace:SecureGateway.UI.Converters"
        Title="SecureGateway" Height="640" Width="760"
        MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" Foreground="#CDD6F4" FontSize="13"
        Closing="OnWindowClosing" StateChanged="OnWindowStateChanged">

    <!-- Same layout as the macOS window (SecureGateway.Mac/Views/MainWindow.axaml); keep them in step.
         Palette: Base #1E1E2E, Mantle #181825, Surface0 #313244, Surface1 #45475A,
         Text #CDD6F4, Subtext #A6ADC8, Blue #89B4FA, Green #A6E3A1, Red #F38BA8. -->
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToStatusColorConverter x:Key="BoolToStatusColor"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:EnumBooleanConverter x:Key="EnumBool"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover and keyboard focus highlight the border, so coloured buttons keep their colour. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#89B4FA"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="BorderBrush" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#F38BA8"/>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Big Connect / Disconnect: filled blue to connect, outlined red to disconnect. -->
        <Style x:Key="ConnectButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="#F38BA8"/>
                    <Setter Property="Foreground" Value="#F38BA8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
        </Style>
        <Style x:Key="Stat" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" Margin="0,0,2,0"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#89B4FA"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List rows: highlight on hover/selection, no default blue system highlight. -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#232338"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A4A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#89B4FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: brand left, account right. Connection state lives on Home, not here. -->
        <Border Grid.Row="0" Background="#181825" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusColor}}"/>
                    <TextBlock Text="SecureGateway" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserEmail}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="{loc:T 'Sign out'}" Style="{StaticResource QuietButton}" Click="OnLogoutClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Margin="8,0,8,0">

            <!-- HOME: one status, one action, one server choice. -->
            <TabItem Header="{loc:T 'Home'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="520" Margin="20,24,20,24">

                        <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Ellipse Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,14,0"
                                             Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusColor}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusHeadline}" FontSize="22" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Hint}" MaxWidth="400"
                                                   Visibility="{Binding StatusDetail, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:T 'Server'}" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="1" Content="{loc:T 'Test'}" Style="{StaticResource ModernButton}" Padding="10,4"
                                            Command="{Binding TestLatencyCommand}" ToolTip="{loc:T 'Measure the latency to this server'}"/>
                                </Grid>
                                <!-- A short list instead of a drop-down: one click per server, and it fits the dark theme. -->
                                <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                                         IsHitTestVisible="{Binding IsIdle}" MaxHeight="150"
                                         Background="#181825" BorderBrush="#45475A" BorderThickness="1"
                                         ItemContainerStyle="{StaticResource RowItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="{loc:T 'Server'}"
                                         Visibility="{Binding HasServers, Converter={StaticResource BoolToVis}}">
                                    <!-- Locked while connected without IsEnabled=False, which paints the WPF ListBox white. -->
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIdle}" Value="False">
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="10,7" LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}">
                                                    <Run Text="{Binding Address, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource Hint}"
                                           Visibility="{Binding HasServers, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                           Text="{loc:T 'No servers yet. Open the Servers tab and click Sync Shared to load your company’s servers.'}"/>

                                <Button Style="{StaticResource ConnectButton}" Margin="0,18,0,0"
                                        Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}"
                                        IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBool}}"/>

                                <!-- Live numbers only while connected; zeros are noise. -->
                                <UniformGrid Columns="4" Margin="0,18,0,0"
                                             Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Latency'}" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding Latency}" Style="{StaticResource Stat}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Download'}" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding DownloadSpeed}" Style="{StaticResource Stat}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Upload'}" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding UploadSpeed}" Style="{StaticResource Stat}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Time'}" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding ConnectionDuration}" Style="{StaticResource Stat}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Routing'}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <RadioButton Content="{loc:T 'Rule-Based'}" GroupName="ProxyMode"
                                                 IsChecked="{Binding ProxyMode, Converter={StaticResource EnumBool}, ConverterParameter=Rule}"/>
                                    <RadioButton Content="{loc:T 'Global Proxy'}" GroupName="ProxyMode"
                                                 IsChecked="{Binding ProxyMode, Converter={StaticResource EnumBool}, ConverterParameter=Global}"/>
                                    <RadioButton Content="{loc:T 'Direct (No Proxy)'}" GroupName="ProxyMode"
                                                 IsChecked="{Binding ProxyMode, Converter={StaticResource EnumBool}, ConverterParameter=Direct}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SERVERS: list first; actions grouped by what they act on. -->
            <TabItem Header="{loc:T 'Servers'}">
                <Grid Margin="12,16,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel>
                            <Button Content="{loc:T 'Sync Shared'}" Style="{StaticResource AccentButton}" Margin="0,0,8,6"
                                    Command="{Binding SyncSharedServersCommand}" ToolTip="{loc:T 'Load the servers your company has shared'}"/>
                            <Button Content="{loc:T 'Import from Clipboard'}" Style="{StaticResource ModernButton}" Margin="0,0,8,6"
                                    Command="{Binding ImportFromClipboardCommand}" ToolTip="{loc:T 'Paste a vmess:// or ss:// link'}"/>
                            <Button Content="{loc:T 'Add Server'}" Style="{StaticResource ModernButton}" Margin="0,0,8,6"
                                    Command="{Binding AddServerCommand}"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="{loc:T 'Test All'}" Style="{StaticResource ModernButton}" Margin="0,0,0,6"
                                VerticalAlignment="Top" Command="{Binding TestAllLatencyCommand}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                                 Background="#181825" BorderBrush="#313244" BorderThickness="1"
                                 ItemContainerStyle="{StaticResource RowItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="{loc:T 'Servers'}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <Border Background="#45475A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{loc:T 'Shared'}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Margin="0,3,0,0">
                                            <Run Text="{Binding Protocol, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Address, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Remarks}" Style="{StaticResource Hint}" Margin="0,3,0,0"
                                                   Visibility="{Binding Remarks, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                                    Visibility="{Binding HasServers, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="{loc:T 'No servers yet'}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Hint}" TextAlignment="Center"
                                       Text="{loc:T 'Click Sync Shared to load your company’s servers, or copy a server link and click Import from Clipboard.'}"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="{loc:T 'Selected server:'}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <Button Content="{loc:T 'Edit'}" Style="{StaticResource ModernButton}" Margin="0,0,8,6" Command="{Binding EditServerCommand}"/>
                        <Button Content="{loc:T 'Duplicate'}" Style="{StaticResource ModernButton}" Margin="0,0,8,6" Command="{Binding DuplicateServerCommand}"/>
                        <Button Content="{loc:T 'Test'}" Style="{StaticResource ModernButton}" Margin="0,0,8,6" Command="{Binding TestLatencyCommand}"/>
                        <Button Content="{loc:T 'Share QR'}" Style="{StaticResource ModernButton}" Margin="0,0,8,6" Command="{Binding ShowShareLinkCommand}"
                                ToolTip="{loc:T 'Show a QR code / link for phone VPN apps'}"/>
                        <Button Content="{loc:T 'Share'}" Style="{StaticResource ModernButton}" Margin="0,0,8,6" Command="{Binding ShareServerCommand}"
                                ToolTip="{loc:T 'Admins: publish this server to every user'}"/>
                        <Button Content="{loc:T 'Unshare'}" Style="{StaticResource ModernButton}" Margin="0,0,8,6" Command="{Binding UnshareServerCommand}"
                                ToolTip="{loc:T 'Admins: stop sharing this server'}"/>
                        <Button Content="{loc:T 'Delete'}" Style="{StaticResource DangerButton}" Margin="0,0,0,6" Command="{Binding DeleteServerCommand}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:T 'Settings'}">
                <ScrollViewer Margin="12,16,12,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:T 'Application Settings'}" Style="{StaticResource Heading}" Margin="0,0,0,14"/>
                        <CheckBox Content="{loc:T 'Start with Windows'}" IsChecked="{Binding AutoStart}"/>
                        <CheckBox Content="{loc:T 'Auto-connect on startup'}" IsChecked="{Binding AutoConnect}"/>
                        <CheckBox Content="{loc:T 'Minimize to system tray on close'}" IsChecked="{Binding MinimizeToTray}"/>

                        <!-- Bilingual on purpose: findable whichever language the app is in. -->
                        <TextBlock Text="Language / 语言" Style="{StaticResource Heading}" Margin="0,16,0,8"/>
                        <WrapPanel>
                            <RadioButton Content="{loc:T 'Automatic (system language)'}" GroupName="UiLanguage"
                                         IsChecked="{Binding Language, Converter={StaticResource EnumBool}, ConverterParameter=Auto}"/>
                            <RadioButton Content="English" GroupName="UiLanguage"
                                         IsChecked="{Binding Language, Converter={StaticResource EnumBool}, ConverterParameter=English}"/>
                            <RadioButton Content="简体中文" GroupName="UiLanguage"
                                         IsChecked="{Binding Language, Converter={StaticResource EnumBool}, ConverterParameter=Chinese}"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Foreground="#F9E2AF"
                                   Text="Restart SecureGateway to use the new language. / 重新启动 SecureGateway 后使用新语言。"
                                   Visibility="{Binding LanguageRestartNeeded, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{loc:T 'Sites that bypass the VPN'}" Style="{StaticResource Heading}" Margin="0,16,0,4"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="{loc:T 'One per line. These connect directly with your real IP, in every proxy mode. Use it for sites that reject the VPN’s address (banks, streaming, company portals). A domain covers all its subdomains; IPs and CIDR ranges work too. Applied when you click elsewhere; the tunnel restarts for a second.'}"/>
                        <TextBox Text="{Binding DirectDomainsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="120"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                 Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" CaretBrush="#CDD6F4"
                                 Padding="8,6" AutomationProperties.Name="{loc:T 'Sites that bypass the VPN'}"/>

                        <TextBlock Text="{loc:T 'About'}" Style="{StaticResource Heading}" Margin="0,20,0,8"/>
                        <TextBlock Style="{StaticResource Hint}">
                            <Run Text="SecureGateway v"/><Run Text="{Binding AppVersion, Mode=OneTime}"/><Run Text="{loc:T '. Supports V2Ray (VMess) and Shadowsocks via the bundled v2ray-core engine.'}"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:T 'Log'}">
                <Grid Margin="12,16,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{loc:T 'Clear Log'}" Style="{StaticResource ModernButton}" Command="{Binding ClearLogCommand}"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                             Background="#181825" Foreground="#CDD6F4"
                             BorderBrush="#313244" FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             x:Name="LogListBox"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
