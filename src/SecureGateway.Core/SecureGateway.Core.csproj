<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral core shared by the Windows (WPF) and macOS (Avalonia) apps:
       models, config, v2ray engine, auth/Supabase, connection orchestration, view-model base. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SecureGateway</RootNamespace>
    <AssemblyName>SecureGateway.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Supabase" Version="1.1.1" />
  </ItemGroup>

</Project>
